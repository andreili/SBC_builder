		};
		pins2 {
			pinmux = <STM32_PINMUX('Z', 7, ANALOG)>; /* USART1_TX */
		};
	};

	usart1_sleep_pins_z_mx: usart1_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('Z', 6, ANALOG)>, /* USART1_RX */

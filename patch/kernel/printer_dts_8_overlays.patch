diff --git a/arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2-printer.dtso b/arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2-printer.dtso
new file mode 100644
index 000000000000..410763276a6b
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2-printer.dtso
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pwm/pwm.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/power/rk3568-power.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/rk3568-cru.h>
+
+&pinctrl {
+    gpio-dht11 {
+        gpio_dht11:gpio-dht11 {
+            rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+        };
+    };
+};
+
+&sfc {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	flash@0 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <100000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <1>;
+	};
+};
+
+&i2c3 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	w1_ms: w1@18 {
+		compatible = "maxim,ds2484";
+		reg = <0x18>;
+		status = "okay";
+	};
+};
+
+&pwm5 {
+    status = "okay";
+};
+
+&{/} {
+	fan_inlet: pwm-fan_inlet {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+		cooling-levels = <0 50 100 150 200 255>;
+		pwms = <&pwm5 0 10000000 PWM_POLARITY_INVERTED>;
+		status = "okay";
+	};
+
+   dht11: dht11 {
+       compatible = "dht11";
+       gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
+       pinctrl-names = "default";
+       pinctrl-0 = <&gpio_dht11>;
+       status = "okay";
+   };
+};
+&uart9 {
+	pinctrl-0 = <&uart9m1_xfer>;
+	pinctrl-names = "default";
+	status = "okay";
+};

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-pcie.dtso b/arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2-dsi1.dtso
new file mode 100644
index 000000000000..9cb6e8f03685
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2-dsi1.dtso
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/soc/rockchip,vop2.h>
+#include <dt-bindings/power/rk3568-power.h>
+
+&hdmi {
+	status = "disabled";
+};
+&hdmi_sound {
+	status = "disabled";
+};
+&i2s0_8ch {
+	status = "disabled";
+};
+&i2s1_8ch {
+	status = "disabled";
+};
+&i2c3 {
+	status = "disabled";
+};
+
+&tft_tp {
+	status = "disabled";
+};
+
+&vp1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	vp1_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
+		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
+		remote-endpoint = <&dsi1_in_vp1>;
+	};
+};
+
+&gpu {
+	status = "okay";
+};
+&vop {
+	status = "okay";
+};
+&vop_mmu {
+	status = "okay";
+};
+&display_subsystem {
+	status = "okay";
+};
+&dsi_dphy1 {
+	status = "okay";
+};
+
+&vp0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	vp0_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
+		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
+		remote-endpoint = <&dsi1_in_vp0>;
+	};
+};
+
+&dsi1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	phy-supply = <&vdd_logic>;
+
+	dsi1_panel: panel@0 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "btt-pitft";
+		reg = <0x0>;
+		status = "okay";
+		power-supply = <&vcc3v3_sys>;
+		vddc-supply = <&bl_dsi>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				panel_in_dsi1: endpoint {
+					remote-endpoint = <&dsi1_out_panel>;
+				};
+			};
+		};
+	};
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dsi1_in: port@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0>;
+
+			dsi1_in_vp0: endpoint@0 {
+				remote-endpoint = <&vp0_out_dsi1>;
+			};
+
+			dsi1_in_vp1: endpoint@1 {
+				remote-endpoint = <&vp1_out_dsi1>;
+			};
+		};
+
+		dsi1_out: port@1 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <1>;
+			dsi1_out_panel: endpoint {
+				remote-endpoint = <&panel_in_dsi1>;
+			};
+		};
+	};
+};
+
+&i2c2 {
+	status = "okay";
+	clock-frequency = <100000>;
+	avdd-1v8-supply = <&vcca1v8_image>;
+	avdd-0v9-supply = <&vdda0v9_image>;
+	power-domains = <&power RK3568_PD_VI>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	bl_dsi: regulator@45 {
+		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
+		reg = <0x45>;
+		status = "okay";
+	};
+
+	tp_dsi: touchscreen@38 {
+		compatible = "edt,edt-ft5306";
+		reg = <0x38>;
+		status = "okay";
+
+		vcc-supply = <&vcc3v3_sys>;
+		iovcc-supply = <&vcc_3v3>;
+
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+	};
+};

/* DSI1 output */
&vop {
	status = "okay";
};
&vop_mmu {
	status = "okay";
};
&display_subsystem {
	status = "okay";
};
&dsi1 {
	status = "okay";
};
&dsi1_panel {
	status = "okay";
};
&dsi1_in_vp1 {
	status = "okay";
};
&dsi_dphy1 {
	status = "okay";
};
&tp_dsi {
	status = "okay";
};
&bl_dsi {
	status = "okay";
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

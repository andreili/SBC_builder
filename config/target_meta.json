[
    {
        "atf":
        {
            "url": "https://github.com/ARM-software/arm-trusted-firmware.git",
            "config": false,
            "is_shared": false
        }
    },
    {
        "uboot":
        {
            "url": "https://github.com/u-boot/u-boot.git",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": false
        }
    },
    {
        "kernel":
        {
            "type": "kernel",
            "url": "https://github.com/torvalds/linux.git",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": true,
            "version": "v6.18",
            "version_type": "tag",
            "patch_dir": [ "kernel", "kernel/rockchip64-6.19" ],
            "config_def": "printer_defconfig",
            "target": [ "Image", "modules", "dtbs", "modules_install" ],
            "artifacts":
            [
                {
                    "file": "",
                    "store_type": "none",
                    "kmods": true
                },
                {
                    "file": "arch/arm64/boot/Image",
                    "store_type": "boot"
                }
            ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_dir}%/kmods/usr INSTALL_MOD_STRIP=1",
            "modules":
            [
                "rtl8189ES_linux"
            ]
        }
    },
    {
        "linuxfw":
        {
            "type": "linuxfw",
            "url": "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git",
            "config": false,
            "is_shared": false,
            "version": "@",
            "version_type": "head",
            "target": "",
            "makeopts": "DESTDIR=%{out_dir}%/kmods/usr"
        }
    },
    {
        "busybox":
        {
            "url": "https://git.busybox.net/busybox",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": false
        }
    },
    {
        "rtl8189ES_linux":
        {
            "url": "https://github.com/jwrdegoede/rtl8189ES_linux.git",
            "config": false,
            "is_shared": true,
            "version": "rtl8189fs",
            "version_type": "branch",
            "target": [ "modules", "strip", "install" ],
            "patch_dir": [ "rtl8189fs" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=arm64 MODDESTDIR=%{out_dir}%/kmods/usr/lib/modules/*/kernel/drivers/net/wireless KSRC=%{common_dir}%/kernel_%{ARCH}% INSTALL_MOD_STRIP=1",
            "artifacts":
            []
        }
    },
    {
        "rkbin":
        {
            "url": "https://github.com/rockchip-linux/rkbin",
            "config": false,
            "is_shared": false
        }
    }
]

{
    "build":
    [
        "atf", "uboot", "fip", "kernel"
    ],
    "variables":
    [
        "CHOST:armv7a-unknown-linux-gnueabihf",
        "KERNEL_ARCH:arm",
        "CROSS_C:%{CHOST}%-",
        "ARCH:armv7a_hf",
        "ATF_PLATFORM:stm32mp1",
        "CHIP:stm32mp157c",
        "CHIP_FAMILY:stm32mp15",
        "BOARD:dk2",
        "ATF_LOG:LOG_LEVEL_INFO",
        "ATF_OPTS:DEBUG=0 ARCH=aarch32 ARM_ARCH_MAJOR=7 STM32MP_SDMMC=1 STM32MP15=1 DTB_FILE_NAME=%{CHIP}%-%{BOARD}%.dtb",
        "ATF_BIN:tf-a-%{CHIP}%-%{BOARD}%.stm32"
    ],
    "targets":
    [
        {
            "parent": "atf",
            "version": "lts-v2.10.13",
            "version_type": "tag",
            "patch_dir": "atf/stm32/mp1",
            "target": [ "clean", "all" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLAT=%{ATF_PLATFORM}% %{ATF_OPTS}% LOG_LEVEL=%{ATF_LOG}%",
             "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/%{ATF_BIN}%",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "kernel",
            "url": "https://github.com/STMicroelectronics/linux.git",
            "version": "v6.6-stm32mp-r2",
            "version_type": "tag",
            "bare_dir": "linux_stm",
            "patch_dir": [],
            "config_def": "stm32mp157c-dk2",
            "config_set": "linux_min,system_live,no_snd",
            "is_shared": false,
            "target": [ "modules_prepare", "uImage", "modules", "dtbs", "modules_install" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_dir}%/kmods/usr INSTALL_MOD_STRIP=1 LOADADDR=0xC2000040",
            "artifacts":
            [
                {
                    "file": "arch/arm/boot/uImage",
                    "store_type": "boot"
                }
            ],
            "modules": []
        },
        {
            "parent": "fip",
            "version": "lts-v2.10.13",
            "version_type": "tag",
            "patch_dir": "atf/stm32/mp1",
            "target": [ "clean", "fip" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLAT=%{ATF_PLATFORM}% %{ATF_OPTS}% AARCH32_SP=optee BL32=/mnt/work/SBC/universal/out/stm32dk2/bin/tee-header_v2-stm32mp157c-dk2-opteemin.bin BL32_EXTRA1=/mnt/work/SBC/universal/out/stm32dk2/bin/tee-pager_v2-stm32mp157c-dk2-opteemin.bin BL32_EXTRA2=/mnt/work/SBC/universal/out/stm32dk2/bin/tee-pageable_v2-stm32mp157c-dk2-opteemin.bin BL33=/mnt/work/SBC/universal/out/stm32dk2/bin/u-boot-nodtb-%{CHIP_FAMILY}%-fastboot-sdcard.bin BL33_CFG=/mnt/work/SBC/universal/out/stm32dk2/bin/u-boot-%{CHIP}%-%{BOARD}%-fastboot-sdcard.dtb",
             "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/fip.bin",
                    "store_type": "temp"
                }
            ]
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",
        "partitions":
        [
            {
                "name": "fsbl1",
                "size": "256K",
                "first_sector": "34",
                "guid_type": "8DA63339-0007-60C0-C436-083AC8230908"
            },
            {
                "name": "fsbl2",
                "size": "256K",
                "guid_type": "8DA63339-0007-60C0-C436-083AC8230908"
            },
            {
                "name": "metadata1",
                "size": "256K",
                "guid_type": "8A7A84A0-8387-40F6-AB41-A8B9A5A60D23"
            },
            {
                "name": "metadata2",
                "size": "256K",
                "guid_type": "8A7A84A0-8387-40F6-AB41-A8B9A5A60D23"
            },
            {
                "name": "fip-a",
                "size": "4M",
                "guid_type": "19D5DF83-11B0-457b-BE2C-7559C13142A5",
                "guid_part": "4FD84C93-54EF-463F-A7EF-AE25FF887087"
            },
            {
                "name": "fip-b",
                "size": "4M",
                "guid_type": "19D5DF83-11B0-457b-BE2C-7559C13142A5",
                "guid_part": "09C54952-D5BF-45AF-ACEE-335303766FB3"
            },
            {
                "name": "u-boot-env",
                "size": "128K",
                "guid_type": "3DE21764-95BD-54BD-A5C3-4ABE786F38A8"
            },
            {
                "name": "boot",
                "size": "64M"
            },
            {
                "name": "vendorfs",
                "size": "16M"
            },
            {
                "name": "rootfs",
                "size": "4G",
                "guid_part": "e91c4e10-16e6-4c0e-bd0e-77becf4a3582"
            },
            {
                "name": "userfs",
                "size": "4G"
            }
        ]
    }
}

{
    "build":
    [
        "fip_st", "kernel"
    ],
    "variables":
    [
        "CHOST:armv7a-unknown-linux-gnueabihf",
        "KERNEL_ARCH:arm",
        "CROSS_C:%{CHOST}%-",
        "ARCH:armv7a_hf",
        "ATF_PLATFORM:stm32mp1",
        "CHIP:stm32mp157c",
        "CHIP_FAMILY:stm32mp15",
        "BOARD:cube-mx",
        "DTS_DIR:%{ROOT_DIR}%/%{cfg_dir}%/dts_cube",
        "ATF_LOG:LOG_LEVEL=LOG_LEVEL_NOTICE",
        "ATF_OPTS:PLAT=%{ATF_PLATFORM}% DEBUG=0 ARCH=aarch32 ARM_ARCH_MAJOR=7 STM32MP_SDMMC=1 STM32MP15=1 AARCH32_SP=optee DTB_FILE_NAME=%{CHIP}%-%{BOARD}%.dtb PSA_FWU_SUPPORT=1 %{ATF_LOG}% TFA_EXTERNAL_DT=%{DTS_DIR}%/tf-a",
        "ATF_BIN:tf-a-%{CHIP}%-%{BOARD}%.stm32",
        "TEE_LOG:CFG_TEE_CORE_LOG_LEVEL=TRACE_INFO",
        "TEE_DBG:CFG_TEE_CORE_DEBUG=n",
        "TEE_MIN:NOWERROR=1",
        "TEE_OPTS:PLATFORM=%{ATF_PLATFORM}% ARCH=arm CFG_ARM32_core=y CFG_EMBED_DTB_SOURCE_FILE=%{CHIP}%-%{BOARD}%.dts %{TEE_LOG}% CFG_EXT_DTS=%{DTS_DIR}%/optee-os CFG_STM32MP_PROFILE=system_services %{TEE_MIN}% %{TEE_DBG}%",
        "BL32_FN:tee-header_v2.bin",
        "BL32E1_FN:tee-pager_v2.bin",
        "BL32E2_FN:tee-pageable_v2.bin",
        "BL33_FN:u-boot-nodtb.bin",
        "BL33_CFG:u-boot.dtb",
        "FSBL_FN:u-boot-spl.stm32",
        "SSBL_FN:u-boot.img"
    ],
    "targets":
    [
        {
            "parent": "atf_st",
            "version": "v2.10-stm32mp",
            "version_type": "branch",
            "patch_dir": "atf/stm32/mp1",
            "target": [ "clean", "all" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% %{ATF_OPTS}%",
             "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/%{ATF_BIN}%",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "op_tee_st",
            "version": "4.0.0-stm32mp",
            "version_type": "branch",
            "patch_dir": "op_tee_st/stm32mp1",
            "deps": [ "atf_st" ],
            "target": [ "clean", "all" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLATFORM=%{ATF_PLATFORM}% %{TEE_OPTS}% O=build",
             "artifacts":
            [
                {
                    "file": "build/core/%{BL32E1_FN}%",
                    "store_type": "temp"
                },
                {
                    "file": "build/core/%{BL32_FN}%",
                    "store_type": "temp"
                },
                {
                    "file": "build/core/%{BL32E2_FN}%",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "uboot_st",
            "version": "v2023.10-stm32mp",
            "version_type": "branch",
            "patch_dir":
            [
                "uboot/stm32mp1",
                "uboot/old"
            ],
            "artifacts":
            [
                {
                    "file": "%{BL33_FN}%",
                    "store_type": "temp"
                },
                {
                    "file": "%{BL33_CFG}%",
                    "store_type": "temp"
                },
                {
                    "file": "tools/mkfwumdata",
                    "store_type": "temp"
                }
            ],
            "target": [ "clean", "all" ],
            "config_def": "%{CHIP_FAMILY}%_defconfig",
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% DEVICE_TREE=%{CHIP}%-%{BOARD}% EXT_DTS=%{DTS_DIR}%/u-boot"
        },
        {
            "parent": "fip_st",
            "version": "@",
            "version_type": "head",
            "patch_dir": "atf/stm32/mp1",
            "deps": [ "atf_st", "op_tee_st", "uboot_st" ],
            "target": [ "clean", "fip" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLAT=%{ATF_PLATFORM}% %{ATF_OPTS}% BL32=%{out_dir}%/%{BL32_FN}% BL32_EXTRA1=%{out_dir}%/%{BL32E1_FN}% BL32_EXTRA2=%{out_dir}%/%{BL32E2_FN}% BL33=%{out_dir}%/%{BL33_FN}% BL33_CFG=%{out_dir}%/%{BL33_CFG}%",
             "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/fip.bin",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "kernel",
            "url": "https://github.com/STMicroelectronics/linux.git",
            "version": "v6.6-stm32mp",
            "version_type": "branch",
            "bare_dir": "linux_stm",
            "patch_dir": [ "kernel/stm32mp1" ],
            "config_def": "stm32mp157c-dk2",
            "config_set": "linux_min,system_live,no_snd",
            "is_shared": false,
            "target": [ "modules_prepare", "uImage", "modules", "dtbs", "modules_install" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_dir}%/kmods/usr INSTALL_MOD_STRIP=1 LOADADDR=0xC2000040 KBUILD_EXTDTS=%{DTS_DIR}%/kernel",
            "artifacts":
            [
                {
                    "file": "arch/arm/boot/dts/st/%{CHIP}%-%{BOARD}%.dtb",
                    "store_type": "boot",
                    "subdir": "",
                    "destdir": "dtb"
                },
                {
                    "file": "arch/arm/boot/uImage",
                    "store_type": "boot"
                }
            ],
            "modules": []
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",
        "partitions":
        [
            {
                "name": "fsbl1",
                "size": "256K",
                "first_sector": "34",
                "guid_type": "8DA63339-0007-60C0-C436-083AC8230908"
            },
            {

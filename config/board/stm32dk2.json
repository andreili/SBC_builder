{
    "build":
    [
        "uboot", "kernel"
    ],
    "variables":
    [
        "CHOST:armv7a-unknown-linux-gnueabihf",
        "KERNEL_ARCH:arm",
        "CROSS_C:%{CHOST}%-",
        "ARCH:armv7a_hf"
    ],
    "targets":
    [
        {
            "parent": "kernel",
            "url": "https://github.com/STMicroelectronics/linux.git",
            "version": "v6.6-stm32mp-r2",
            "version_type": "tag",
            "bare_dir": "linux_stm",
            "patch_dir": [],
            "config_def": "stm32mp157c-dk2",
            "config_set": "linux_min,system_live,no_snd",
            "is_shared": false,
            "target": [ "modules_prepare", "uImage", "modules", "dtbs", "modules_install" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_dir}%/kmods/usr INSTALL_MOD_STRIP=1 LOADADDR=0xC2000040",
            "artifacts":
            [
                {
                    "file": "arch/arm/boot/uImage",
                    "store_type": "boot"
                }
            ],
            "modules": []
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",

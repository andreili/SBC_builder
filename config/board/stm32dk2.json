                "size": "256K",
                "guid_type": "8A7A84A0-8387-40F6-AB41-A8B9A5A60D23"
            },
            {
                "name": "fip-a",
                "size": "4M",
                "guid_type": "19D5DF83-11B0-457b-BE2C-7559C13142A5",
                "guid_part": "4FD84C93-54EF-463F-A7EF-AE25FF887087"
            },
            {
                "name": "fip-b",
                "size": "4M",
                "guid_type": "19D5DF83-11B0-457b-BE2C-7559C13142A5",
                "guid_part": "09C54952-D5BF-45AF-ACEE-335303766FB3"
            },
            {
                "name": "u-boot-env",
                "size": "128K",
                "guid_type": "3DE21764-95BD-54BD-A5C3-4ABE786F38A8"
            },
            {

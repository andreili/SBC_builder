{
    "build":
    [
        "initramfs", "uboot", "kernel"
    ],
    "variables":
    [
        "CHOST:armv7a-unknown-linux-gnueabihf",
        "KERNEL_ARCH:arm",
        "CROSS_C:%{CHOST}%-",
        "ARCH:armv7a_hf"
    ],
    "targets":
    [
        {
            "parent": "uboot",
            "version": "v2024.01",
            "version_type": "tag",
            "patch_dir": "uboot/sunxi",
            "artifacts":
            [
                {
                    "file": "u-boot-sunxi-with-spl.bin",
                    "store_type": "dd",
                    "block_size": "1k",
                    "img_offset": 8
                }
            ],
            "target": [ "" ],
            "config_def": "orangepi_zero2_defconfig",
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% BL31=%{out_dir}%/bl31.bin"
        },
        {
            "name": "kernel_v853",
            "type": "kernel",
            "url": "https://github.com/lindenis-org/lindenis-v853-lichee-linux-4.9.git",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": false,
            "version": "@",
            "version_type": "head",
            "patch_dir": [ "kernel/old_4" ],
            "target": [ "modules_prepare", "uImage", "modules", "dtbs", "modules_install" ],
            "have_defconfig": false,
            "artifacts":
            [
                {
                    "file": "",
                    "store_type": "none",
                    "kmods": true
                },
                {
                    "file": "arch/arm/boot/uImage",
                    "store_type": "boot"
                }
            ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_sh}%/kmods/usr",
            "config_def": "opi_zero2_printer_defconfig"
        }
    ],
    "install":
    {
        "target": "image",
        "block_size": "512b",
        "type": "mbr",
        "partitions":
        [
            {
                "name": "boot",
                "size": "1g",
                "first_sector": "2048"
            },
            {
                "name": "rw",
                "size": "2g"
            }
        ]
    }
}

{
    "build":
    [
        "initramfs", "uboot", "kernel"
    ],
    "variables":
    [
        "CHOST:armv7a-unknown-linux-gnueabihf",
        "KERNEL_ARCH:arm",
        "CROSS_C:%{CHOST}%-",
        "ARCH:armv7a_hf",
        "DTB_FILE:sun8iw21p1-printer.dtb"
    ],
    "targets":
    [
        {
            "name": "uboot",
            "type": "uboot",
            "url": "https://github.com/lindenis-org/lindenis-v853-lichee-brandy-2.0-u-boot-2018.git",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": false,
            "version": "@",
            "version_type": "head",
            "patch_dir": [ "uboot/old" ],
            "artifacts":
            [
                {
                    "file": "u-boot-sun8iw21p1.bin",
                    "store_type": "dd",
                    "block_size": "1k",
                    "img_offset": 8
                }
            ],
            "target": [ "" ],
            "config_def": "v853-lindenis_defconfig",
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% TARGET_BOARD=sun8i_v853_printer"
        },
        {
            "name": "kernel",
            "type": "kernel",
            "url": "https://github.com/lindenis-org/lindenis-v853-lichee-linux-4.9.git",
            "config": true,
            "config_target": "menuconfig",
            "is_shared": false,
            "version": "@",
            "version_type": "head",
            "patch_dir": [ "kernel/old_4" ],
            "target": [ "modules_prepare", "zImage", "modules", "dtbs", "modules_install" ],
            "artifacts":
            [
                {
                    "file": "",
                    "store_type": "none",
                    "kmods": true
                },
                {
                    "file": "arch/arm/boot/zImage",
                    "store_type": "boot"
                },
                {
                    "file": "arch/arm/boot/dts/%{DTB_FILE}%",
                    "store_type": "boot",
                    "subdir": "dtb/allwinner",
                    "destdir": "dtb"
                }
            ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCH=%{KERNEL_ARCH}% INSTALL_MOD_PATH=%{out_dir}%/kmods/usr",
            "config_def": "opi_zero2_printer_defconfig"
        }
    ],
    "install":
    {
        "target": "image",
        "block_size": "512b",
        "type": "mbr",
        "partitions":
        [
            {
                "name": "boot",
                "size": "1g",
                "first_sector": "2048"
            },
            {
                "name": "rw",
                "size": "2g"
            }
        ]
    }
}

{
    "build":
    [
        "uboot", "kernel"
    ],
    "variables":
    [
        "CHOST:aarch64-unknown-linux-gnu",
        "KERNEL_ARCH:arm64",
        "CROSS_C:%{CHOST}%-",
        "ATF_PLATFORM:rk3568",
        "TPL_BIN:rk3566_ddr_1056MHz_v1.23.bin",
        "BL31_BIN:bl31.elf",
        "ARCH:aarch64",
        "DTB_FILE:rockchip/rk3566-bigtreetech-pi2.dtb",
        "DTO_FILES:rockchip/rk3566-*.dtbo",
        "DTO_DIR:rockchip/overlays"
    ],
    "targets":
    [
        {
            "parent": "atf",
            "version": "@",
            "version_type": "head",
            "patch_dir": "",
            "target": [ "bl31" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLAT=%{ATF_PLATFORM}% DEBUG=0",
            "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/bl31/bl31.elf",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "rkbin",
            "version": "@",
            "version_type": "head",
            "target": [ "bl31" ],
            "no_build": 1,
            "artifacts":
            [
                {
                    "file": "bin/rk35/%{TPL_BIN}%",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "uboot",
            "version": "@",
            "version_type": "head",
            "patch_dir": "uboot/btt",
            "deps":
            [
                "atf", "rkbin"
            ],
            "artifacts":
            [
                {
                    "file": "idbloader.img",
                    "store_type": "dd",
                    "block_size": "512b",
                    "img_offset": 64
                },
                {
                    "file": "idbloader.img",
                    "store_type": "boot"
                },
                {
                    "file": "u-boot.itb",
                    "store_type": "dd",
                    "block_size": "512b",
                    "img_offset": 16384
                },
                {
                    "file": "u-boot.itb",
                    "store_type": "boot"
                },
                {
                    "file": "u-boot-rockchip-spi.bin",
                    "store_type": "boot"
                }
            ],
            "target": [ "" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCHV=%{ARCH}% ROCKCHIP_TPL=%{out_dir}%/%{TPL_BIN}% BL31=%{out_dir}%/%{BL31_BIN}%"
        },
        {
            "parent": "kernel",
            "config_def": "rk3566-bigtreetech-cb2-manta_defconfig",
            "config_set": "arm64_linux_min,rk_all,printer_all,sys_rk809,nvme_blk",
            "artifacts":
            [
                {
                    "file": "arch/arm64/boot/dts/rockchip/rk3566-bigtreetech-pi2.dtb",
                    "store_type": "boot",
                    "subdir": "dtb/rockchip",
                    "destdir": "dtb"
                },
                {
                    "file": "arch/arm64/boot/dts/rockchip/rk3566-*.dtbo",
                    "store_type": "none",
                    "subdir": "dtb/rockchip/overlays"
                }
            ]
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",
        "partitions":
        [
            {
                "name": "boot",
                "size": "1G",
                "first_sector": "32768"
            },
            {
                "name": "rw",
                "size": "2G"
            }
        ],
        "overlays":
        [
            "/dtb/%{DTO_DIR}%/rk3566-bigtreetech-pi2-printer.dtbo",
            "/dtb/%{DTO_DIR}%/rk3566-bigtreetech-pi2-sfc.dtbo",
            "/dtb/%{DTO_DIR}%/rk3566-bigtreetech-pi2-dsi1.dtbo"
        ]
    }
}

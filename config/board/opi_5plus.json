{
    "build":
    [
        "uboot", "kernel"
    ],
    "variables":
    [
        "CHOST:aarch64-unknown-linux-gnu",
        "KERNEL_ARCH:arm64",
        "CROSS_C:%{CHOST}%-",
        "TPL_BIN:rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.19.bin",
        "ATF_PLATFORM:rk3588",
        "BL31_BIN:bl31.elf",
        "ARCH:aarch64",
        "DTB_FILE:rockchip/rk3588-orangepi-5-plus.dtb",
        "DTO_FILES:rockchip/rk3588-*.dtbo",
        "DTO_DIR:rockchip/overlays"
    ],
    "targets":
    [
        {
            "parent": "atf",
            "version": "@",
            "version_type": "head",
            "patch_dir": "",
            "target": [ "bl31" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% PLAT=%{ATF_PLATFORM}% DEBUG=0",
            "artifacts":
            [
                {
                    "file": "build/%{ATF_PLATFORM}%/release/bl31/bl31.elf",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "rkbin",
            "version": "@",
            "version_type": "head",
            "target": [ "bl31" ],
            "no_build": 1,
            "artifacts":
            [
                {
                    "file": "bin/rk35/%{TPL_BIN}%",
                    "store_type": "temp"
                }
            ]
        },
        {
            "parent": "uboot",
            "version": "@",
            "version_type": "head",
            "patch_dir": "uboot/btt",
            "config_def": "orangepi-5-plus-rk3588_defconfig",
            "deps":
            [
                "atf", "rkbin"
            ],
            "artifacts":
            [
                {
                    "file": "idbloader.img",
                    "store_type": "dd",
                    "block_size": "512b",
                    "img_offset": 64
                },
                {
                    "file": "u-boot.itb",
                    "store_type": "dd",
                    "block_size": "512b",
                    "img_offset": 16384
                },
                {
                    "file": "u-boot-rockchip-spi.bin",
                    "store_type": "boot"
                }
            ],
            "target": [ "" ],
            "makeopts": "CROSS_COMPILE=%{CROSS_C}% ARCHV=%{ARCH}% ROCKCHIP_TPL=%{out_dir}%/%{TPL_BIN}% BL31=%{out_dir}%/%{BL31_BIN}%"
        },
        {
            "parent": "kernel",
            "config_def":
            [
                "rk3566-bigtreetech-cb2-manta",
                "rk3588-orangepi-5-plus"
            ],
            "config_set": "arm64_linux_min,rk_all,printer_all,sys_rk809,nvme_blk,typec_video,net_rtl8125,net_ax210",
            "artifacts":
            [
                {
                    "file": "",
                    "store_type": "none",
                    "kmods": true
                },
                {
                    "file": "arch/arm64/boot/Image",
                    "store_type": "boot"
                },
                {
                    "file": "arch/arm64/boot/dts/%{DTB_FILE}%",
                    "store_type": "boot",
                    "subdir": "dtb/rockchip",
                    "destdir": "dtb"
                },
                {
                    "file": "arch/arm64/boot/dts/%{DTO_FILES}%",
                    "store_type": "none",
                    "subdir": "dtb/%{DTO_DIR}%"
                }
            ]
        },
        {
            "parent": "linuxfw",
            "artifacts":
            [
                {
                    "file": "rtl_nic/*",
                    "store_type": "temp",
                    "subdir": "kmods/usr/lib/firmware/rtl_nic"
                },
                {
                    "file": "intel/iwlwifi/iwlwifi-ty-a0-gf-a0-89.ucode",
                    "store_type": "temp",
                    "subdir": "kmods/usr/lib/firmware"
                },
                {
                    "file": "intel/iwlwifi/iwlwifi-ty-a0-gf-a0.pnvm",
                    "store_type": "temp",
                    "subdir": "kmods/usr/lib/firmware"
                },
                {
                    "file": "arm/mali/arch10.8/*",
                    "store_type": "temp",
                    "subdir": "kmods/usr/lib/firmware/arm/mali/arch10.8"
                }
            ]
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",
        "partitions":
        [
            {
                "name": "boot",
                "size": "1G",
                "first_sector": "32768"
            },
            {
                "name": "rw",
                "size": "2G"
            }
        ],
        "_overlays":
        [
            "/dtb/%{DTO_DIR}%/rk3566-sfc-nor.dtbo",
            "/dtb/%{DTO_DIR}%/rk3566-w1-gpio4-pb2.dtbo",
            "/dtb/%{DTO_DIR}%/rk3566-dsi1.dtbo",
            "/dtb/%{DTO_DIR}%/rk3566-pcie.dtbo"
        ]
    }
}

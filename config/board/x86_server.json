{
    "build":
    [
        "kernel"
    ],
    "variables":
    [
        "CHOST:x86_64-pc-linux-gnu",
        "CROSS_C:",
        "KERNEL_ARCH:x86_64",
        "ARCH:x86_64"
    ],
    "targets":
    [
        {
            "parent": "kernel",
            "config_def": "x86_64_defconfig",
            "config_set": "linux_min,rk_all,system_live,no_snd,nvme_blk",
            "artifacts": [],
            "is_shared": false,
            "target": [ "bzImage", "modules", "modules_install" ]
        }
    ],
    "install":
    {
        "target": "image",
        "type": "gpt",
        "block_size": "512b",
        "partitions":
        [
            {
                "name": "boot",
                "size": "1G",
                "first_sector": "32768"
            },
            {
                "name": "rw",
                "size": "2G"
            }
        ],
        "overlays": [],
        "files": []
    }
}

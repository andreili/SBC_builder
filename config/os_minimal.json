{
    "variables":
    [
        "USER_LOGIN:sysint",
        "USER_ID:1010"
    ],
    "install":
    {
        "steps":
        [
            { "soft_clean": "default" }
        ]
    },
    "finalize":
    {
        "steps":
        [
            { "sudo": "chmod u+s ./usr/bin/Xorg" },
            { "_chroot": "sudo -i -u %{USER_LOGIN}% python -m venv /home/%{USER_LOGIN}%/venv" },
            { "chroot": "emerge -C virtual/gui_min" },
            { "soft_clean": "bdeps" },
            { "cleanup": "excl" },
            { "cleanup": "no_compiler" }
        ]
    }
}

{
    "variables":
    [
        "USER_LOGIN:sysint",
        "USER_ID:1010"
    ],
    "install":
    {
        "steps":
        [
            { "soft_clean": "default" }
        ]
    },
    "finalize":
    {
        "steps":
        [
            { "_sudo": "chmod u+s ./usr/bin/Xorg" },
            { "chroot": "groupadd -g %{USER_ID}% %{USER_LOGIN}%" },
            { "chroot": "useradd -m -G wheel,video,audio,disk,usb -g %{USER_ID}% -u %{USER_ID}% %{USER_LOGIN}% --password %{USER_LOGIN}%" },
            { "chroot": "echo '%{USER_LOGIN}%:%{USER_LOGIN}%' | chpasswd" },
            { "_chroot": "sudo -i -u %{USER_LOGIN}% python -m venv /home/%{USER_LOGIN}%/venv" },
            { "soft_clean": "bdeps" }
        ]
    }
}
